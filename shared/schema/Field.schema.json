{
  "$defs": {
    "Composite": {
      "additionalProperties": false,
      "description": "A FALSE-COLOR infrared composite of one observing season, as an RGB(A) PNG on the field grid.\n\nSPHEREx observes 0.75-5.0 um, invisible to the eye: red/green/blue are assigned to infrared\nwavelengths (see CompositeMode). It is NOT a true-color image and the UI must say so.",
      "properties": {
        "channels": {
          "description": "Exactly three channels, in the order red, green, blue",
          "items": {
            "$ref": "#/$defs/CompositeChannel"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Channels",
          "type": "array"
        },
        "id": {
          "description": "Unique within the field, e.g. 'detectors_S0'",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "image": {
          "description": "RGB/RGBA PNG on the field grid, path relative to the field directory (no '..', no absolute or Windows paths), e.g. 'color/detectors_S0.png'",
          "pattern": "\\.png$",
          "title": "Image",
          "type": "string"
        },
        "mjd_max": {
          "description": "Latest mid-exposure MJD among the inputs [days]",
          "title": "Mjd Max",
          "type": "number"
        },
        "mjd_min": {
          "description": "Earliest mid-exposure MJD among the inputs [days]",
          "title": "Mjd Min",
          "type": "number"
        },
        "mode": {
          "description": "detectors = whole SPHEREx detectors over the full 0.75-5.0 um range; jhk = 2MASS-like, exposures near J/H/Ks (~1.25/1.65/2.15 um). Blue = shortest, red = longest wavelengths.",
          "enum": [
            "detectors",
            "jhk"
          ],
          "title": "Mode",
          "type": "string"
        },
        "notes": {
          "description": "Plain-language caveats for the UI",
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "season": {
          "description": "0-based observing season of the field (0 = earliest)",
          "minimum": 0,
          "title": "Season",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "mode",
        "season",
        "mjd_min",
        "mjd_max",
        "image",
        "channels"
      ],
      "title": "Composite",
      "type": "object"
    },
    "CompositeChannel": {
      "additionalProperties": false,
      "description": "One color channel of a FALSE-COLOR composite: which infrared exposures were mapped to it.",
      "properties": {
        "color": {
          "description": "Display channel these infrared exposures are mapped to",
          "enum": [
            "red",
            "green",
            "blue"
          ],
          "title": "Color",
          "type": "string"
        },
        "detector": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SPHEREx detector of every input; None = inputs from several detectors",
          "title": "Detector"
        },
        "frame_ids": {
          "description": "Exposures combined into this channel (Frame.id convention). They may include exposures that are not published in Field.frames.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Frame Ids",
          "type": "array"
        },
        "wavelength_max_um": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Longest central wavelength among the inputs at the field centre [um]",
          "title": "Wavelength Max Um"
        },
        "wavelength_min_um": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shortest central wavelength among the inputs at the field centre [um]",
          "title": "Wavelength Min Um"
        },
        "wavelength_um": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean central wavelength of the inputs at the field centre [um]",
          "title": "Wavelength Um"
        }
      },
      "required": [
        "color",
        "frame_ids"
      ],
      "title": "CompositeChannel",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "description": "One SPHEREx exposure (one detector), reprojected onto the field grid.",
      "properties": {
        "bandwidth_um": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bandwidth Um"
        },
        "date_obs": {
          "description": "Same instant as mjd, ISO-8601 UTC (header DATE-AVG)",
          "format": "date-time",
          "title": "Date Obs",
          "type": "string"
        },
        "detector": {
          "description": "1-3 SWIR, 4-6 MWIR",
          "maximum": 6,
          "minimum": 1,
          "title": "Detector",
          "type": "integer"
        },
        "id": {
          "description": "Unique within the field, e.g. '2025W19_2B_0007_1D1'",
          "title": "Id",
          "type": "string"
        },
        "image": {
          "description": "PNG path relative to the field directory, e.g. 'frames/<id>.png'",
          "title": "Image",
          "type": "string"
        },
        "mjd": {
          "description": "Mid-exposure time [MJD days]: header MJD-AVG (fallbacks in docs/DATA.md; MJD-OBS is the START)",
          "title": "Mjd",
          "type": "number"
        },
        "obs_id": {
          "description": "SPHEREx OBSID header value",
          "title": "Obs Id",
          "type": "string"
        },
        "release": {
          "enum": [
            "dr1",
            "qr2",
            "qr3",
            "synthetic"
          ],
          "title": "Release",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original FITS (IRSA or S3 URL)",
          "title": "Source Uri"
        },
        "stretch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stretch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "valid_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fraction of grid with valid, unflagged pixels",
          "title": "Valid Fraction"
        },
        "wavelength_um": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Central wavelength at the field center (from WCS-WAVE)",
          "title": "Wavelength Um"
        }
      },
      "required": [
        "id",
        "obs_id",
        "detector",
        "mjd",
        "date_obs",
        "release",
        "image"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Grid": {
      "additionalProperties": false,
      "description": "Common north-up TAN grid every frame of a field is reprojected onto.",
      "properties": {
        "center": {
          "$ref": "#/$defs/SkyCoord"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "pixel_scale_arcsec": {
          "exclusiveMinimum": 0,
          "title": "Pixel Scale Arcsec",
          "type": "number"
        },
        "wcs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "FITS WCS cards of the grid (CTYPE/CRVAL/CRPIX/CDELT), FITS convention",
          "title": "Wcs",
          "type": "object"
        },
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "center",
        "width_px",
        "height_px",
        "pixel_scale_arcsec",
        "wcs"
      ],
      "title": "Grid",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "built_at": {
          "format": "date-time",
          "title": "Built At",
          "type": "string"
        },
        "data_releases": {
          "items": {
            "enum": [
              "dr1",
              "qr2",
              "qr3",
              "synthetic"
            ],
            "type": "string"
          },
          "title": "Data Releases",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "synthetic": {
          "description": "True = fake data for development. The UI MUST say so.",
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "pipeline_version",
        "built_at",
        "synthetic"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SkyCoord": {
      "additionalProperties": false,
      "properties": {
        "dec": {
          "description": "ICRS declination [deg]",
          "maximum": 90,
          "minimum": -90,
          "title": "Dec",
          "type": "number"
        },
        "ra": {
          "description": "ICRS right ascension [deg]",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Ra",
          "type": "number"
        }
      },
      "required": [
        "ra",
        "dec"
      ],
      "title": "SkyCoord",
      "type": "object"
    },
    "Stretch": {
      "additionalProperties": false,
      "description": "How the PNG was scaled from physical units, so the UI can show a colorbar.",
      "properties": {
        "method": {
          "default": "asinh",
          "enum": [
            "linear",
            "asinh",
            "log",
            "zscale"
          ],
          "title": "Method",
          "type": "string"
        },
        "unit": {
          "default": "MJy/sr",
          "title": "Unit",
          "type": "string"
        },
        "vmax": {
          "title": "Vmax",
          "type": "number"
        },
        "vmin": {
          "title": "Vmin",
          "type": "number"
        }
      },
      "required": [
        "vmin",
        "vmax"
      ],
      "title": "Stretch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A patch of sky with all its frames. Called 'Field' in JSON Schema / TypeScript.",
  "properties": {
    "center": {
      "$ref": "#/$defs/SkyCoord"
    },
    "composites": {
      "description": "Optional FALSE-COLOR infrared composites per observing season (infrared wavelengths mapped to RGB, not true color). Empty when none were built; absent in products older than 0.3.1.",
      "items": {
        "$ref": "#/$defs/Composite"
      },
      "title": "Composites",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/Frame"
      },
      "title": "Frames",
      "type": "array"
    },
    "grid": {
      "$ref": "#/$defs/Grid"
    },
    "id": {
      "description": "URL-safe slug",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "size_deg": {
      "exclusiveMinimum": 0,
      "title": "Size Deg",
      "type": "number"
    },
    "tags": {
      "description": "e.g. 'ecliptic', 'deep-field', 'planet-nine-region'",
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "center",
    "size_deg",
    "grid",
    "frames",
    "provenance"
  ],
  "title": "Field",
  "type": "object"
}

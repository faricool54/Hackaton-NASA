              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flux Err"
        },
        "frame_id": {
          "title": "Frame Id",
          "type": "string"
        },
        "mjd": {
          "title": "Mjd",
          "type": "number"
        },
        "obs_id": {
          "title": "Obs Id",

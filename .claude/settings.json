{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/dev.py:*)",
      "Bash(python3 scripts/dev.py:*)",
      "Bash(py scripts/dev.py:*)",
      "Bash(python scripts/owners.py:*)",
      "Bash(python3 scripts/owners.py:*)",
      "Bash(py scripts/owners.py:*)",
      "PowerShell(python scripts/dev.py:*)",
      "PowerShell(py scripts/dev.py:*)",
      "PowerShell(python scripts/owners.py:*)",
      "PowerShell(py scripts/owners.py:*)",
      "Bash(.venv/bin/errante:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/Scripts/errante:*)",
      "Bash(.venv/Scripts/pytest:*)",
      "Bash(.venv/Scripts/ruff:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm --prefix frontend run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "WebFetch(domain:irsa.ipac.caltech.edu)",
      "WebFetch(domain:caltech-ipac.github.io)",
      "WebFetch(domain:nasa-irsa-spherex.s3.us-east-1.amazonaws.com)",
      "WebFetch(domain:ssd-api.jpl.nasa.gov)",
      "WebFetch(domain:ssd.jpl.nasa.gov)",
      "WebFetch(domain:ssp.imcce.fr)",
      "WebFetch(domain:vizier.cfa.harvard.edu)",
      "WebFetch(domain:gea.esac.esa.int)",
      "WebFetch(domain:skies.esac.esa.int)",
      "WebFetch(domain:cds-astro.github.io)",
      "WebFetch(domain:docs.astropy.org)",
      "WebFetch(domain:www.spaceappschallenge.org)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git add -A:*)",
      "PowerShell(git add .:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./frontend/.env.local)"
    ]
  }
}
